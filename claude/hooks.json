{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/play-sound.sh\" ding.wav"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/play-sound.sh\" waiting.wav"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/play-sound.sh\" denied.wav"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"$HOME/.claude/logs\" 2>/dev/null; jq -r '(now | localtime | strftime(\"%Y-%m-%d %H:%M:%S\")) + \" \" + .tool_input.command' >> \"$HOME/.claude/logs/bash-history.log\" 2>/dev/null; true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null); if [ -n \"$branch\" ]; then gitstatus=$(git status --short 2>/dev/null); jq -n --arg b \"$branch\" --arg s \"$gitstatus\" '{hookSpecificOutput: {hookEventName: \"UserPromptSubmit\", additionalContext: (\"Git branch: \" + $b + (if $s == \"\" then \" (clean)\" else \"\\nGit status:\\n\" + $s end))}}'; fi"
          }
        ]
      }
    ]
  }
}
